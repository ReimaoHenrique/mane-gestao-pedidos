{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mané Gestão de Pedidos",
  "version": "0.1.0",
  "identifier": "com.mane.pedidos",
  "build": {
    "frontendDist": "../dist/frontend",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "pnpm ng serve",
    "beforeBuildCommand": "pnpm ng build"
  },
  "app": {
    "windows": [
      {
        "title": "Mané - Gestão de Pedidos",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
